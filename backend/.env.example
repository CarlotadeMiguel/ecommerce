# Configuración básica de Flask
FLASK_ENV=development  # Entorno de ejecución (development/production)
FLASK_APP=app.py       # Punto de entrada de la aplicación
DEBUG=True             # Modo depuración (False en producción)

# Seguridad
SECRET_KEY=your_secret_key_here            # Clave para firmar cookies y sesiones
JWT_SECRET_KEY=your_jwt_secret_key_here    # Clave para tokens JWT

# Base de datos
DATABASE_URL=postgresql://user:password@localhost/dbname  # URL de conexión SQL
SQLALCHEMY_TRACK_MODIFICATIONS=False       # Desactivar seguimiento de modificaciones

# Correo electrónico (Opcional)
MAIL_SERVER=smtp.example.com      # Servidor SMTP
MAIL_PORT=587                     # Puerto SMTP
MAIL_USE_TLS=True                 # Usar TLS
MAIL_USERNAME=your_email@example.com  
MAIL_PASSWORD=your_email_password

# Servicios externos (Ejemplos)
STRIPE_API_KEY=sk_test_your_stripe_key    # Clave de API Stripe
GOOGLE_CLIENT_ID=your_google_client_id    # OAuth Google
